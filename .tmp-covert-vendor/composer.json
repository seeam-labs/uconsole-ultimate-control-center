{
  "name": "temporary/covert-vendor-builder",
  "type": "project",
  "description": "Temporary isolated dependency build for Covert API vendor artifact",
  "require": {
    "php": "^8.2",
    "laravel/framework": "11.50.0",
    "laravel/sanctum": "4.3.1",
    "laravel/socialite": "5.25.0",
    "filament/filament": "3.3.49",
    "google/apiclient": "2.19.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
